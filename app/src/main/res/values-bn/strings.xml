    <string name="instructions_browsing">📖  অনুসন্ধান ও ব্রাউজিং\nসাবডিরেক্টরি দেখতে যেকোনো ফোল্ডারে ট্যাপ করুন। শিরোনাম বা লেখক অনুযায়ী বই খুঁজতে ওপরের সার্চ বার ব্যবহার করুন।</string>
    <string name="instructions_navigation">📁  ফোল্ডার নেভিগেশন\nপূর্ববর্তী ফোল্ডারে ফিরে যেতে ওপরে থাকা ব্যাক অ্যারো বা ব্রেডক্রাম্ব বারে ট্যাপ করুন।</string>
    <string name="instructions_offline">📥  অফলাইন পড়া ও ক্যাশ\nবই পড়তে বা ডাউনলোড করতে ট্যাপ করুন। ডাউনলোড করা বই অফলাইনে সংরক্ষিত থাকবে যতক্ষণ না আপনি ক্যাশ থেকে মুছেন।</string>
    <string name="instructions_reading">👓  পড়ার সুবিধাসমূহ\nভিউয়ার টুলবার থেকে উল্লম্ব বা অনুভূমিক পেজ মোড পরিবর্তন করুন, নির্দিষ্ট পাতায় জাম্প করুন বা নাইট মোড চালু করুন।</string>
    <string name="instructions_contact_dev">📩  যেকোনো বইয়ের প্রয়োজনে\nআপনার প্রয়োজনীয় কোনো বই বা সিলেবাসের বই অ্যাপে না পাওয়া গেলে, লাইব্রেরিতে যুক্ত করার জন্য সরাসরি টেলিগ্রাম, হোয়াটসঅ্যাপ বা ফেসবুকে ডেভেলপারের সাথে যোগাযোগ করুন!</string>

    <!-- About Dev Dialog -->
    <string name="about_dev_subtitle">ডেভেলপার পরিচিতি</string>
    <string name="about_dev_bio">আসসালামু আলাইকুম, আমি 𝐒𝐑𝟕 𝐌𝐨𝐝𝐬।\n\nআমি কুড়িগ্রাম সরকারি কলেজের বাংলা বিভাগের একজন অনার্স শিক্ষার্থী।\n\nআমি একজন অ্যান্ড্রয়েড ডেভেলপার এবং রিভার্স ইঞ্জিনিয়ার।\n\nআমি অ্যান্ড্রয়েড অ্যাপস তৈরি ও মোডিং, ওয়েব ডেভেলপমেন্ট, এথিক্যাল সিকিউরিটি রিসার্চ এবং রুট/নন-রুট মডিউল তৈরিতে আগ্রহী।\n\nযেকোনো সহায়তা বা যৌথ কাজের জন্য আমার সাথে যোগাযোগ করতে পারেন। ধন্যবাদ!</string>

